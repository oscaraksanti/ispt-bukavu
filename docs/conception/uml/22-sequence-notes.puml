@startuml sequence-notes
!include _style.iuml
title Séquence — saisie, validation et publication des notes
autonumber "<b>0."
actor Enseignant as T
participant "Interface web" as UI
participant "Serveur" as S
database "Base de\ndonnées" as DB
actor "Secrétariat\nacadémique" as A
actor Étudiant as E

T -> UI : Ouvre l'évaluation de son cours
UI -> S : grilleNotes(évaluation)
S -> S : vérifier que T enseigne ce cours
S --> UI : étudiants inscrits et notes existantes
T -> UI : Saisit les notes
UI -> S : enregistrerNotes(liste)
S -> S : contrôler bornes (0 à 20)
S -> DB : notes en BROUILLON
T -> UI : Soumet
UI -> S : soumettre(évaluation)
S -> DB : notes = SOUMISES, journal
S -> A : notification
A -> UI : Contrôle et valide
UI -> S : valider(évaluation)
S -> DB : notes = VALIDÉES
A -> UI : Publie après délibération
UI -> S : publier(évaluation)
S -> DB : notes = PUBLIÉES, journal
S -> E : notification « nouvelle note »
E -> UI : Consulte son relevé
UI -> S : releve(étudiant, semestre)
S -> DB : notes PUBLIÉES uniquement
S --> UI : moyennes et crédits calculés
@enduml
