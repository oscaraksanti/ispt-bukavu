@startuml sequence-notes
!include _style.iuml
title Séquence — saisie, validation et publication des notes
autonumber "<b>0."
actor Enseignant as T
participant "Interface web" as UI
participant "Serveur" as S
database "Base de\ndonnées" as DB
actor "Secrétariat\nacadémique" as A
actor Étudiant as E

T -> UI : Ouvre une évaluation de son cours
UI -> S : grille de notes
S -> S : vérifier que le cours lui est confié
S --> UI : étudiants inscrits et notes existantes
T -> UI : Saisit les notes ou les absences
UI -> S : enregistrerNotes(liste)
S -> S : contrôler les bornes (0 à 20)
S -> DB : notes enregistrées (évaluation en BROUILLON)
T -> UI : Transmet
UI -> S : transmettreEvaluation(évaluation)
S -> S : chaque étudiant a une note ou une absence ?
S -> DB : évaluation = SOUMISE, journal
A -> UI : Relit les statistiques et valide
UI -> S : changerStatutEvaluation(VALIDEE)
S -> S : permission « academique.notes.valider »\net transition autorisée
S -> DB : évaluation = VALIDEE, journal
A -> UI : Publie
UI -> S : changerStatutEvaluation(PUBLIEE)
S -> DB : évaluation = PUBLIEE, journal
S -> E : notification « Nouvelle note publiée »
E -> UI : Consulte ses notes
UI -> S : notes de l'étudiant connecté
S -> DB : évaluations PUBLIEE uniquement
S --> UI : notes et moyenne par cours
@enduml
