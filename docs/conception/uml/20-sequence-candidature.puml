@startuml sequence-candidature
!include _style.iuml
title Séquence — dépôt et instruction d'une candidature
autonumber "<b>0."
actor Candidat as C
participant "Interface web" as UI
participant "Serveur\n(actions)" as S
database "Base de\ndonnées" as DB
participant "Stockage\nfichiers" as F
participant "Service\nemail" as M
actor "Caisse" as K
actor "Secrétariat /\nsection" as A

C -> UI : Crée son compte
UI -> S : creerCompteCandidat(email, mot de passe)
S -> DB : créer le compte et un jeton de confirmation
S -> M : lien de confirmation
S --> UI : message identique, que l'adresse soit connue ou non
C -> UI : Ouvre le lien et confirme
UI -> S : confirmerEmail(jeton)
C -> UI : Remplit son dossier
UI -> S : enregistrerDossier(données)
loop pour chaque pièce exigée
  C -> UI : Téléverse la pièce
  UI -> S : deposerPiece(fichier)
  S -> S : contrôler le type réel et la taille
  S -> F : enregistrer le fichier (privé)
  S -> DB : créer PieceDeposee
end
C -> UI : Indique le mode et la référence du paiement, puis dépose
UI -> S : soumettreDossier()
S -> S : email confirmé ? pièces obligatoires ? frais déclarés ?
alt dossier complet
  S -> DB : statut = SOUMISE, historique
  S --> UI : numéro de dossier
else éléments manquants
  S --> UI : liste des éléments manquants
end
K -> S : verifierPaiementDossier(dossier)
S -> S : permission « finances.encaisser »
S -> DB : reçu AD-AAAA-NNNN, montant figé
A -> S : statuerPiece(pièce, acceptée / rejetée)
A -> S : deciderCandidature(dossier, décision, motif)
S -> S : permission « admissions.decider »\net transition autorisée
S -> DB : statut = ADMISE / REFUSEE / COMPLEMENT,\nhistorique et journal
S -> M : email et notification au candidat
@enduml
