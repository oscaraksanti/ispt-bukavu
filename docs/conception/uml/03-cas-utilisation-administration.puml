@startuml cas-utilisation-administration
!include _style.iuml
left to right direction
skinparam linetype polyline
title Cas d'utilisation — administration

actor "Direction" as D
actor "Secrétariat\nacadémique" as A
actor "Appariteur /\nsection" as S
actor "Caisse" as K
actor "Communication" as M
actor "Administrateur\ntechnique" as X

rectangle "Administration" {
  together {
    usecase "Consulter le tableau\nde bord de pilotage" as U1
    usecase "Valider les\ncommuniqués" as U2
    usecase "Gérer la structure\nacadémique (LMD)" as U3
    usecase "Valider et publier\nles notes" as U4
    usecase "Conduire une\ndélibération" as U5
    usecase "Émettre un document\nvérifiable" as U6
    usecase "Instruire les\ncandidatures" as U7
    usecase "Construire l'horaire et\nplanifier les examens" as U8
  }
  together {
    usecase "Gérer les stages\net les offres" as U9
    usecase "Enregistrer un paiement\net émettre le reçu" as U10
    usecase "Vérifier les frais\nde dossier" as U11
    usecase "Modifier les pages,\nactualités et galerie" as U12
    usecase "Modérer l'annuaire\ndes anciens" as U13
    usecase "Gérer les comptes,\nrôles et permissions" as U14
    usecase "Consulter le journal\nd'activité" as U15
  }
}
D --> U1
D --> U2
A --> U3
A --> U4
A --> U5
A --> U6
S --> U7
S --> U8
U9 <-- S
U10 <-- K
U11 <-- K
U12 <-- M
U13 <-- M
U14 <-- X
U15 <-- X
U2 -[hidden]-> U10
U4 -[hidden]-> U12
U6 -[hidden]-> U14
@enduml
