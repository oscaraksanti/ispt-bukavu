@startuml sequence-communique
!include _style.iuml
title Séquence — publication d'un communiqué ciblé sur la valve
autonumber "<b>0."
actor "Auteur\n(section / enseignant)" as A
participant "Interface web" as UI
participant "Serveur" as S
database "Base de\ndonnées" as DB
actor "Validateur\n(direction)" as V
actor "Étudiant ciblé" as E

A -> UI : Rédige, joint un fichier, choisit la cible
UI -> S : enregistrerCommunique(titre, contenu, cible)
S -> S : l'auteur peut-il cibler ce périmètre ?\n(institut, filière, promotion ou cours)
alt cible « institut » ou « public » et auteur non validateur
  S -> DB : statut = EN_VALIDATION
  S -> V : notification « Communiqué à valider »
  V -> UI : Relit et approuve
  UI -> S : validerCommunique(communiqué)
  S -> S : permission « valve.valider »
  S -> DB : statut = PUBLIE, journal
else autre cas
  S -> DB : statut = PUBLIE, journal
end
S -> DB : calculer les destinataires
S -> E : notification « Nouveau communiqué à la valve »
E -> UI : Ouvre sa valve
UI -> S : communiqués visibles pour son profil
S -> DB : filtrer selon ses inscriptions en cours
S --> UI : liste triée (épinglés d'abord)
E -> UI : Ouvre le communiqué
UI -> S : marquerLu(communiqué)
S -> DB : créer Lecture (accusé de lecture)
@enduml
