@startuml etats-candidature
!include _style.iuml
skinparam linetype polyline
hide empty description
title États d'une candidature
state "Brouillon" as Brouillon
state "Soumise" as Soumise
state "En examen" as EnExamen
state "Complément demandé" as ComplementDemande
state "Admise" as Admise
state "Refusée" as Refusee
state "Inscrite" as Inscrite
state "Abandonnée" as Abandonnee
[*] --> Brouillon
Brouillon --> Soumise : soumettre\n[pièces obligatoires présentes]
Soumise --> EnExamen : ouvrir
EnExamen --> ComplementDemande : demander un complément
ComplementDemande --> Soumise : compléter
EnExamen --> Admise : admettre
EnExamen --> Refusee : refuser
Admise --> Inscrite : inscrire\n[frais d'inscription enregistrés]
Brouillon --> Abandonnee : clôture de la campagne
Refusee --> [*]
Inscrite --> [*]
Abandonnee --> [*]
@enduml
