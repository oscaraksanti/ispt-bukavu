@startuml composants
!include _style.iuml
skinparam linetype polyline
title Architecture logique de l'application
package "Présentation" {
  [Site public] as P1
  [Espace candidat] as P2
  [Espace étudiant] as P3
  [Espace enseignant] as P4
  [Administration] as P5
}
package "Application (serveur)" {
  [Contrôle d'accès\n(rôles et permissions)] as A0
  [Admissions] as A1
  [Valve] as A2
  [Académique\n(structure, horaires, notes)] as A3
  [Frais] as A4
  [Documents\nvérifiables] as A5
  [Contenus et médias] as A6
  [Notifications] as A7
  [Journal d'activité] as A8
}
package "Infrastructure" {
  [Accès aux données\n(ORM)] as I1
  [Stockage de fichiers] as I2
  [Envoi d'emails] as I3
  [Génération PDF\net QR code] as I4
}
P1 --> A6
P1 --> A5
P2 --> A1
P3 --> A2
P3 --> A3
P3 --> A4
P4 --> A2
P4 --> A3
P5 --> A0
A1 --> A7
A2 --> A7
A3 --> A7
A1 --> I2
A6 --> I2
A5 --> I4
A7 --> I3
A0 --> I1
A3 --> I1
A8 --> I1
@enduml
