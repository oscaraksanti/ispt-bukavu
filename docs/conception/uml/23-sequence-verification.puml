@startuml sequence-verification
!include _style.iuml
title Séquence — émission et vérification d'un document officiel
autonumber "<b>0."
actor Étudiant as E
actor "Secrétariat\nacadémique" as A
participant "Serveur" as S
database "Base de\ndonnées" as DB
actor "Vérificateur\n(employeur)" as V

E -> S : demanderDocument(type)
S -> DB : DemandeDocument (EN_ATTENTE)
A -> S : emettreDemande(demande)
S -> S : permission « documents.emettre »
S -> S : générer un code aléatoire non devinable
S -> DB : DocumentOfficiel(code, type, données figées)
S --> E : document disponible (page A4 imprimable\navec code QR vers /verifier/{code})
V -> S : scanne le code QR\nGET /verifier/{code}
S -> DB : rechercher le code
alt document trouvé et non révoqué
  S --> V : AUTHENTIQUE — type, titulaire, date d'émission
else document révoqué
  S --> V : RÉVOQUÉ — date et motif
else code inconnu
  S --> V : AUCUN DOCUMENT
end
@enduml
