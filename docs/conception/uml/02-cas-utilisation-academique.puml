@startuml cas-utilisation-academique
!include _style.iuml
left to right direction
skinparam linetype polyline
title Cas d'utilisation — étudiants et enseignants

actor "Étudiant" as E
actor "Enseignant" as T

rectangle "Espaces étudiant et enseignant" {
  usecase "Consulter la valve\nnumérique" as U1
  usecase "Consulter son horaire" as U2
  usecase "Télécharger les supports\nde cours" as U3
  usecase "Consulter ses notes\net son relevé" as U4
  usecase "Consulter son solde\net ses reçus" as U5
  usecase "Demander un document\nofficiel" as U6
  usecase "Suivre son stage\net déposer le rapport" as U7
  usecase "Publier un communiqué\nà ses étudiants" as U8
  usecase "Déposer des supports" as U9
  usecase "Saisir les notes\nd'une évaluation" as U10
  usecase "Soumettre les notes\nà validation" as U11
  usecase "Signaler un changement\nde séance" as U12
}

E --> U1
E --> U2
E --> U3
E --> U4
E --> U5
E --> U6
E --> U7
U1 <-- T
U2 <-- T
U8 <-- T
U9 <-- T
U10 <-- T
U12 <-- T
U11 .> U10 : <<extend>>
@enduml
