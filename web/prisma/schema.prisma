// Modèle de données de la plateforme ISPT-Bukavu.
// Voir docs/conception/ (diagrammes de classes) pour la vue d'ensemble.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Identité, accès et traçabilité
// ============================================================================

enum StatutCompte {
  INVITE
  ACTIF
  SUSPENDU
}

model Utilisateur {
  id                    String       @id @default(cuid())
  /// Facultatif pour les étudiants, qui se connectent avec leur matricule.
  email                 String?      @unique
  nom                   String
  postnom               String?
  prenom                String?
  telephone             String?
  motDePasseHash        String?
  statut                StatutCompte @default(ACTIF)
  emailVerifieLe        DateTime?
  doitChangerMotDePasse Boolean      @default(false)
  derniereConnexion     DateTime?
  /// Photo de profil : clé dans le stockage privé (visible des seuls membres connectés).
  photoCle              String?
  photoMajLe            DateTime?
  creeLe                DateTime     @default(now())
  majLe                 DateTime     @updatedAt

  roles                UtilisateurRole[]
  sessions             Session[]
  jetons               JetonReinitialisation[]
  profilEtudiant       ProfilEtudiant?
  profilEnseignant     ProfilEnseignant?
  candidatures         Candidature[]               @relation("CandidaturesDuCandidat")
  communiques          Communique[]                @relation("CommuniquesAuteur")
  communiquesValides   Communique[]                @relation("CommuniquesValidateur")
  lectures             Lecture[]
  notifications        Notification[]
  journal              JournalActivite[]
  medias               Media[]
  actualites           Actualite[]
  paiementsEnregistres Paiement[]                  @relation("PaiementsEnregistrePar")
  stagesEncadres       Stage[]                     @relation("StagesEncadreur")
  decisions            Candidature[]               @relation("CandidaturesDecideur")
  participations       ParticipantConversation[]
  messages             Message[]                   @relation("MessagesAuteur")
  signalements         SignalementMessage[]        @relation("SignalementsAuteur")
  blocages             Blocage[]                   @relation("BlocagesFaits")
  bloquePar            Blocage[]                   @relation("BlocagesSubis")
  /// Règles du Campus acceptées (avant la première publication).
  reglesCampusLe       DateTime?
  publications         Publication[]               @relation("PublicationsAuteur")
  commentaires         Commentaire[]               @relation("CommentairesAuteur")
  reactions            ReactionPublication[]
  enregistrements      EnregistrementPublication[]
  signalementsCampus   SignalementCampus[]         @relation("SignalementsCampusAuteur")
  abonnementsPush      AbonnementPush[]
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  libelle     String
  description String?
  /// Rôle prévu par la plateforme : ne peut pas être supprimé.
  systeme     Boolean @default(false)

  permissions  RolePermission[]
  utilisateurs UtilisateurRole[]
}

model Permission {
  code    String @id
  libelle String
  domaine String

  roles RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

model UtilisateurRole {
  utilisateurId String
  roleId        String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, roleId])
}

model Session {
  id            String      @id @default(cuid())
  /// Empreinte SHA-256 du jeton envoyé dans le cookie (le jeton n'est jamais stocké en clair).
  jetonHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime
  creeLe        DateTime    @default(now())
  ip            String?
  agent         String?
  abonnementsPush AbonnementPush[]

  @@index([utilisateurId])
}

model JetonReinitialisation {
  id            String      @id @default(cuid())
  jetonHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime
  utiliseLe     DateTime?
  creeLe        DateTime    @default(now())
}

model TentativeConnexion {
  id      String   @id @default(cuid())
  email   String
  ip      String?
  reussie Boolean
  creeLe  DateTime @default(now())

  @@index([email, creeLe])
  @@index([ip, creeLe])
}

model JournalActivite {
  id       String       @id @default(cuid())
  auteurId String?
  auteur   Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  action   String
  entite   String
  entiteId String?
  avant    Json?
  apres    Json?
  ip       String?
  creeLe   DateTime     @default(now())

  @@index([entite, entiteId])
  @@index([creeLe])
}

model Notification {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          String
  titre         String
  message       String
  lien          String?
  lueLe         DateTime?
  creeLe        DateTime    @default(now())

  @@index([utilisateurId, lueLe])
}

// ============================================================================
// Contenus du site et médiathèque
// ============================================================================

enum StatutPublication {
  BROUILLON
  PUBLIE
  ARCHIVE
}

model Reglage {
  cle    String   @id
  valeur Json
  majLe  DateTime @updatedAt
}

model Media {
  id              String       @id @default(cuid())
  /// Clé de l'objet dans le stockage (indépendante du fournisseur).
  cle             String       @unique
  nomFichier      String
  typeMime        String
  taille          Int
  largeur         Int?
  hauteur         Int?
  texteAlternatif String       @default("")
  legende         String?
  dossier         String       @default("general")
  creeLe          DateTime     @default(now())
  creeParId       String?
  creePar         Utilisateur? @relation(fields: [creeParId], references: [id], onDelete: SetNull)

  albums          AlbumMedia[]
  actualites      Actualite[]
  partenaires     Partenaire[]
  autorites       Autorite[]
  filieres        Filiere[]
  piecesJointes   PieceJointe[]
  piecesDeposees  PieceDeposee[]
  supports        Support[]
  rapportsDeStage Stage[]
  enoncesDevoirs  Devoir[]           @relation("EnonceDevoir")
  remises         Remise[]           @relation("FichierRemise")
  messages        Message[]          @relation("PieceMessage")
  publications    PublicationMedia[]
}

model Page {
  id          String            @id @default(cuid())
  slug        String            @unique
  titre       String
  description String?
  statut      StatutPublication @default(PUBLIE)
  blocs       BlocPage[]
  majLe       DateTime          @updatedAt
}

model BlocPage {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Identifiant du bloc dans la page (accroche, mission, stages…).
  cle     String
  ordre   Int
  visible Boolean @default(true)
  donnees Json

  @@unique([pageId, cle])
}

model Actualite {
  id           String            @id @default(cuid())
  slug         String            @unique
  titre        String
  resume       String
  contenu      String
  couvertureId String?
  couverture   Media?            @relation(fields: [couvertureId], references: [id], onDelete: SetNull)
  statut       StatutPublication @default(BROUILLON)
  publieLe     DateTime?
  auteurId     String?
  auteur       Utilisateur?      @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe       DateTime          @default(now())
  majLe        DateTime          @updatedAt

  @@index([statut, publieLe])
}

model Evenement {
  id          String            @id @default(cuid())
  titre       String
  description String?
  debut       DateTime
  fin         DateTime?
  lieu        String?
  statut      StatutPublication @default(PUBLIE)
}

model Album {
  id          String       @id @default(cuid())
  slug        String       @unique
  titre       String
  description String?
  date        DateTime?
  publie      Boolean      @default(true)
  ordre       Int          @default(0)
  medias      AlbumMedia[]
}

model AlbumMedia {
  albumId String
  mediaId String
  ordre   Int    @default(0)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
}

enum CategoriePartenaire {
  STAGE_PROFESSIONNEL
  STAGE_PEDAGOGIQUE
  EMPLOYEUR
  INSTITUTIONNEL
}

model Partenaire {
  id        String              @id @default(cuid())
  nom       String
  categorie CategoriePartenaire
  logoId    String?
  logo      Media?              @relation(fields: [logoId], references: [id], onDelete: SetNull)
  siteWeb   String?
  ordre     Int                 @default(0)
  visible   Boolean             @default(true)
}

model Autorite {
  id       String  @id @default(cuid())
  fonction String
  nom      String
  photoId  String?
  photo    Media?  @relation(fields: [photoId], references: [id], onDelete: SetNull)
  ordre    Int     @default(0)
  visible  Boolean @default(true)
}

model QuestionFrequente {
  id       String  @id @default(cuid())
  rubrique String  @default("admissions")
  question String
  reponse  String
  ordre    Int     @default(0)
  visible  Boolean @default(true)
}

model MessageContact {
  id        String   @id @default(cuid())
  nom       String
  email     String
  telephone String?
  sujet     String
  message   String
  ip        String?
  traite    Boolean  @default(false)
  creeLe    DateTime @default(now())

  @@index([creeLe])
  @@index([ip, creeLe])
}

// ============================================================================
// Structure académique (LMD)
// ============================================================================

model AnneeAcademique {
  id            String   @id @default(cuid())
  libelle       String   @unique
  debut         DateTime
  fin           DateTime
  courante      Boolean  @default(false)
  /// Seuil de réussite sur 20, paramétrable par année.
  seuilReussite Decimal  @default(10) @db.Decimal(4, 2)

  promotions     Promotion[]
  campagnes      CampagneAdmission[]
  baremes        BaremeFrais[]
  paiements      Paiement[]
  exonerations   Exoneration[]
  stages         Stage[]
  reglement      ReglementAcademique?
  sessionsExamen SessionExamen[]
}

model Filiere {
  id           String   @id @default(cuid())
  slug         String   @unique
  nom          String
  nomCourt     String
  accroche     String
  presentation String
  domaines     String[]
  metiers      String[]
  debouches    String
  entreprendre String
  photoId      String?
  photo        Media?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  ordre        Int      @default(0)
  ouverte      Boolean  @default(true)

  promotions         Promotion[]
  unites             UniteEnseignement[]
  candidatures       Candidature[]
  campagnes          CampagneAdmission[]
  communiques        Communique[]
  baremes            BaremeFrais[]
  anciens            Ancien[]
  offres             OffreInsertion[]
  publicationsCampus Publication[]
}

model Niveau {
  id      String @id @default(cuid())
  code    String @unique
  libelle String
  ordre   Int

  promotions Promotion[]
  unites     UniteEnseignement[]
  baremes    BaremeFrais[]
}

model Promotion {
  id        String          @id @default(cuid())
  filiereId String
  niveauId  String
  anneeId   String
  filiere   Filiere         @relation(fields: [filiereId], references: [id])
  niveau    Niveau          @relation(fields: [niveauId], references: [id])
  annee     AnneeAcademique @relation(fields: [anneeId], references: [id])

  inscriptions  Inscription[]
  cours         CoursOffert[]
  communiques   Communique[]
  deliberations Deliberation[]
  conversations Conversation[]
  publications  Publication[]

  @@unique([filiereId, niveauId, anneeId])
}

enum Sexe {
  F
  M
}

model ProfilEtudiant {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matricule     String      @unique
  sexe          Sexe?
  dateNaissance DateTime?
  lieuNaissance String?

  inscriptions Inscription[]
  notes        Note[]
  paiements    Paiement[]
  exonerations Exoneration[]
  demandes     DemandeDocument[]
  documents    DocumentOfficiel[]
  stages       Stage[]
  candidature  Candidature?
  presences    Presence[]
  remises      Remise[]
  resultats    ResultatDeliberation[]
}

enum StatutInscription {
  EN_ATTENTE
  EN_REGLE
  SUSPENDUE
  DIPLOME
  ABANDON
}

model Inscription {
  id          String            @id @default(cuid())
  etudiantId  String
  promotionId String
  etudiant    ProfilEtudiant    @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  promotion   Promotion         @relation(fields: [promotionId], references: [id])
  statut      StatutInscription @default(EN_ATTENTE)
  creeLe      DateTime          @default(now())

  @@unique([etudiantId, promotionId])
}

model ProfilEnseignant {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  titre         String?
  domaine       String?

  cours         CoursEnseignant[]
  surveillances EpreuveSurveillant[]
}

model UniteEnseignement {
  id        String  @id @default(cuid())
  code      String
  intitule  String
  filiereId String
  niveauId  String
  filiere   Filiere @relation(fields: [filiereId], references: [id])
  niveau    Niveau  @relation(fields: [niveauId], references: [id])
  /// Semestre du parcours, de 1 à 8.
  semestre  Int
  credits   Int

  cours Cours[]

  @@unique([filiereId, code])
}

model Cours {
  id            String            @id @default(cuid())
  ueId          String
  ue            UniteEnseignement @relation(fields: [ueId], references: [id], onDelete: Cascade)
  intitule      String
  credits       Int
  volumeHoraire Int

  offres CoursOffert[]
}

model CoursOffert {
  id          String    @id @default(cuid())
  coursId     String
  promotionId String
  cours       Cours     @relation(fields: [coursId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  enseignants   CoursEnseignant[]
  seances       Seance[]
  supports      Support[]
  devoirs       Devoir[]
  evaluations   Evaluation[]
  communiques   Communique[]
  epreuves      Epreuve[]
  conversations Conversation[]

  @@unique([coursId, promotionId])
}

model CoursEnseignant {
  coursOffertId String
  enseignantId  String
  titulaire     Boolean          @default(true)
  coursOffert   CoursOffert      @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  enseignant    ProfilEnseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@id([coursOffertId, enseignantId])
}

enum StatutSeance {
  PREVUE
  REPORTEE
  ANNULEE
}

model Seance {
  id            String       @id @default(cuid())
  coursOffertId String
  coursOffert   CoursOffert  @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  debut         DateTime
  fin           DateTime
  salle         String?
  statut        StatutSeance @default(PREVUE)
  remarque      String?
  presences     Presence[]

  @@index([debut])
}

enum TypeSupport {
  FICHIER
  LIEN
}

model Support {
  id            String      @id @default(cuid())
  coursOffertId String
  coursOffert   CoursOffert @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  titre         String
  type          TypeSupport
  mediaId       String?
  media         Media?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url           String?
  chapitre      String?
  ordre         Int         @default(0)
  creeLe        DateTime    @default(now())
}

enum TypeEvaluation {
  INTERROGATION
  TRAVAUX_PRATIQUES
  EXAMEN
}

enum StatutEvaluation {
  BROUILLON
  SOUMISE
  VALIDEE
  PUBLIEE
}

model Evaluation {
  id            String           @id @default(cuid())
  coursOffertId String
  coursOffert   CoursOffert      @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  intitule      String
  type          TypeEvaluation
  /// Poids de l'évaluation dans la note du cours (en pourcentage).
  ponderation   Decimal          @db.Decimal(5, 2)
  date          DateTime?
  statut        StatutEvaluation @default(BROUILLON)
  notes         Note[]
}

model Note {
  id           String         @id @default(cuid())
  evaluationId String
  etudiantId   String
  evaluation   Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  etudiant     ProfilEtudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  /// Note sur 20.
  valeur       Decimal?       @db.Decimal(4, 2)
  absent       Boolean        @default(false)
  majLe        DateTime       @updatedAt

  @@unique([evaluationId, etudiantId])
}

// ============================================================================
// Valve numérique
// ============================================================================

enum CibleCommunique {
  PUBLIC
  INSTITUT
  FILIERE
  PROMOTION
  COURS
}

enum StatutCommunique {
  BROUILLON
  EN_VALIDATION
  PUBLIE
  ARCHIVE
}

model Communique {
  id            String           @id @default(cuid())
  titre         String
  contenu       String
  cible         CibleCommunique
  filiereId     String?
  promotionId   String?
  coursOffertId String?
  filiere       Filiere?         @relation(fields: [filiereId], references: [id])
  promotion     Promotion?       @relation(fields: [promotionId], references: [id])
  coursOffert   CoursOffert?     @relation(fields: [coursOffertId], references: [id])
  statut        StatutCommunique @default(BROUILLON)
  epingle       Boolean          @default(false)
  publieLe      DateTime?
  expireLe      DateTime?
  auteurId      String
  auteur        Utilisateur      @relation("CommuniquesAuteur", fields: [auteurId], references: [id])
  validateurId  String?
  validateur    Utilisateur?     @relation("CommuniquesValidateur", fields: [validateurId], references: [id])
  creeLe        DateTime         @default(now())

  piecesJointes PieceJointe[]
  lectures      Lecture[]

  @@index([statut, publieLe])
}

model PieceJointe {
  id           String     @id @default(cuid())
  communiqueId String
  mediaId      String
  communique   Communique @relation(fields: [communiqueId], references: [id], onDelete: Cascade)
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model Lecture {
  communiqueId  String
  utilisateurId String
  luLe          DateTime    @default(now())
  communique    Communique  @relation(fields: [communiqueId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([communiqueId, utilisateurId])
}

// ============================================================================
// Admissions
// ============================================================================

enum StatutCampagne {
  BROUILLON
  OUVERTE
  FERMEE
}

enum Devise {
  USD
  CDF
}

model CampagneAdmission {
  id               String          @id @default(cuid())
  anneeId          String
  annee            AnneeAcademique @relation(fields: [anneeId], references: [id])
  libelle          String
  ouverture        DateTime
  cloture          DateTime
  fraisInscription Decimal         @db.Decimal(10, 2)
  devise           Devise          @default(USD)
  statut           StatutCampagne  @default(BROUILLON)
  filieres         Filiere[]
  pieces           PieceExigee[]
  candidatures     Candidature[]
}

model PieceExigee {
  id          String            @id @default(cuid())
  campagneId  String
  campagne    CampagneAdmission @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  libelle     String
  description String?
  obligatoire Boolean           @default(true)
  ordre       Int               @default(0)
  depots      PieceDeposee[]
}

enum StatutCandidature {
  BROUILLON
  SOUMISE
  EN_EXAMEN
  COMPLEMENT
  ADMISE
  REFUSEE
  INSCRITE
  ABANDONNEE
}

model Candidature {
  id                   String            @id @default(cuid())
  numero               String            @unique
  campagneId           String
  campagne             CampagneAdmission @relation(fields: [campagneId], references: [id])
  candidatId           String
  candidat             Utilisateur       @relation("CandidaturesDuCandidat", fields: [candidatId], references: [id])
  filiereId            String?
  filiere              Filiere?          @relation(fields: [filiereId], references: [id])
  nom                  String?
  postnom              String?
  prenom               String?
  sexe                 Sexe?
  dateNaissance        DateTime?
  lieuNaissance        String?
  nationalite          String?
  telephone            String?
  adresse              String?
  ecoleOrigine         String?
  sectionHumanites     String?
  anneeDiplome         Int?
  pourcentage          Decimal?          @db.Decimal(5, 2)
  referencePaiement    String?
  /// Frais de dossier : mode déclaré par le candidat, vérification par la caisse.
  modePaiement         ModePaiement?
  paiementVerifieLe    DateTime?
  paiementVerifieParId String?
  paiementMotifRefus   String?
  /// Reçu des frais de dossier, numéroté à la vérification (montant figé).
  numeroRecu           String?           @unique
  montantFrais         Decimal?          @db.Decimal(10, 2)
  deviseFrais          Devise?
  statut               StatutCandidature @default(BROUILLON)
  motifDecision        String?
  consentementLe       DateTime?
  soumiseLe            DateTime?
  decideLe             DateTime?
  decideParId          String?
  decidePar            Utilisateur?      @relation("CandidaturesDecideur", fields: [decideParId], references: [id])
  etudiantId           String?           @unique
  etudiant             ProfilEtudiant?   @relation(fields: [etudiantId], references: [id])
  creeLe               DateTime          @default(now())
  majLe                DateTime          @updatedAt

  pieces     PieceDeposee[]
  historique HistoriqueCandidature[]

  @@unique([campagneId, candidatId])
  @@index([statut])
}

enum StatutPiece {
  DEPOSEE
  ACCEPTEE
  REJETEE
}

model PieceDeposee {
  id            String      @id @default(cuid())
  candidatureId String
  pieceExigeeId String
  mediaId       String
  candidature   Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  pieceExigee   PieceExigee @relation(fields: [pieceExigeeId], references: [id])
  media         Media       @relation(fields: [mediaId], references: [id])
  statut        StatutPiece @default(DEPOSEE)
  commentaire   String?
  creeLe        DateTime    @default(now())

  @@unique([candidatureId, pieceExigeeId])
}

model HistoriqueCandidature {
  id            String            @id @default(cuid())
  candidatureId String
  candidature   Candidature       @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  statut        StatutCandidature
  commentaire   String?
  auteurId      String?
  creeLe        DateTime          @default(now())
}

// ============================================================================
// Frais académiques
// ============================================================================

model BaremeFrais {
  id        String          @id @default(cuid())
  anneeId   String
  annee     AnneeAcademique @relation(fields: [anneeId], references: [id])
  niveauId  String?
  niveau    Niveau?         @relation(fields: [niveauId], references: [id])
  filiereId String?
  filiere   Filiere?        @relation(fields: [filiereId], references: [id])
  libelle   String
  montant   Decimal         @db.Decimal(10, 2)
  devise    Devise          @default(USD)
  echeance  DateTime?
}

enum ModePaiement {
  BANQUE
  GUICHET
  MOBILE_MONEY
  AUTRE
}

model Paiement {
  id              String          @id @default(cuid())
  etudiantId      String
  etudiant        ProfilEtudiant  @relation(fields: [etudiantId], references: [id])
  anneeId         String
  annee           AnneeAcademique @relation(fields: [anneeId], references: [id])
  montant         Decimal         @db.Decimal(10, 2)
  devise          Devise          @default(USD)
  mode            ModePaiement
  reference       String
  payeLe          DateTime
  numeroRecu      String          @unique
  enregistreParId String
  enregistrePar   Utilisateur     @relation("PaiementsEnregistrePar", fields: [enregistreParId], references: [id])
  annuleLe        DateTime?
  motifAnnulation String?
  creeLe          DateTime        @default(now())
}

model Exoneration {
  id         String          @id @default(cuid())
  etudiantId String
  etudiant   ProfilEtudiant  @relation(fields: [etudiantId], references: [id])
  anneeId    String
  annee      AnneeAcademique @relation(fields: [anneeId], references: [id])
  montant    Decimal         @db.Decimal(10, 2)
  devise     Devise          @default(USD)
  motif      String
  creeLe     DateTime        @default(now())
}

// ============================================================================
// Documents officiels vérifiables
// ============================================================================

enum TypeDocument {
  ATTESTATION_FREQUENTATION
  RELEVE_NOTES
  ATTESTATION_REUSSITE
  BULLETIN
}

enum StatutDemande {
  EN_ATTENTE
  EMISE
  REFUSEE
}

model DemandeDocument {
  id         String            @id @default(cuid())
  etudiantId String
  etudiant   ProfilEtudiant    @relation(fields: [etudiantId], references: [id])
  type       TypeDocument
  motif      String?
  statut     StatutDemande     @default(EN_ATTENTE)
  creeLe     DateTime          @default(now())
  traiteLe   DateTime?
  document   DocumentOfficiel?
}

model DocumentOfficiel {
  id              String                @id @default(cuid())
  /// Code de vérification public, aléatoire et non devinable.
  code            String                @unique
  type            TypeDocument
  etudiantId      String
  etudiant        ProfilEtudiant        @relation(fields: [etudiantId], references: [id])
  demandeId       String?               @unique
  demande         DemandeDocument?      @relation(fields: [demandeId], references: [id])
  /// Copie figée des informations imprimées sur le document.
  donnees         Json
  emisLe          DateTime              @default(now())
  emisParId       String?
  revoqueLe       DateTime?
  motifRevocation String?
  resultat        ResultatDeliberation?
}

// ============================================================================
// Stages
// ============================================================================

enum TypeStage {
  PEDAGOGIQUE
  PROFESSIONNEL
}

enum StatutStage {
  PREVU
  EN_COURS
  TERMINE
}

model LieuStage {
  id         String    @id @default(cuid())
  nom        String
  type       TypeStage
  adresse    String?
  contact    String?
  telephone  String?
  email      String?
  convention Boolean   @default(false)
  actif      Boolean   @default(true)
  stages     Stage[]
}

model Stage {
  id             String          @id @default(cuid())
  etudiantId     String
  etudiant       ProfilEtudiant  @relation(fields: [etudiantId], references: [id])
  lieuId         String
  lieu           LieuStage       @relation(fields: [lieuId], references: [id])
  anneeId        String
  annee          AnneeAcademique @relation(fields: [anneeId], references: [id])
  type           TypeStage
  debut          DateTime?
  fin            DateTime?
  encadreurId    String?
  encadreur      Utilisateur?    @relation("StagesEncadreur", fields: [encadreurId], references: [id])
  statut         StatutStage     @default(PREVU)
  rapportMediaId String?
  rapport        Media?          @relation(fields: [rapportMediaId], references: [id])
  note           Decimal?        @db.Decimal(4, 2)
  appreciation   String?
}

/**
 * ---------- Présences et devoirs ----------
 */

enum StatutPresence {
  PRESENT
  RETARD
  ABSENT
  EXCUSE
}

/// Appel d'une séance de l'horaire, saisi par l'enseignant du cours.
model Presence {
  id          String         @id @default(cuid())
  seanceId    String
  seance      Seance         @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  etudiantId  String
  etudiant    ProfilEtudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  statut      StatutPresence
  saisieParId String?
  majLe       DateTime       @updatedAt

  @@unique([seanceId, etudiantId])
  @@index([etudiantId])
}

/// Travail à rendre (évaluation formative, distincte des notes officielles).
model Devoir {
  id            String      @id @default(cuid())
  coursOffertId String
  coursOffert   CoursOffert @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  titre         String
  consignes     String
  echeance      DateTime
  accepteRetard Boolean     @default(false)
  enonceId      String?
  enonce        Media?      @relation("EnonceDevoir", fields: [enonceId], references: [id], onDelete: SetNull)
  creeParId     String
  creeLe        DateTime    @default(now())
  remises       Remise[]

  @@index([coursOffertId])
}

/// Copie déposée par un étudiant, puis corrigée par l'enseignant.
model Remise {
  id           String         @id @default(cuid())
  devoirId     String
  devoir       Devoir         @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  etudiantId   String
  etudiant     ProfilEtudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  fichierId    String
  fichier      Media          @relation("FichierRemise", fields: [fichierId], references: [id])
  commentaire  String?
  deposeLe     DateTime
  enRetard     Boolean        @default(false)
  note         Decimal?       @db.Decimal(4, 2)
  appreciation String?
  corrigeLe    DateTime?

  @@unique([devoirId, etudiantId])
}

/**
 * ---------- Délibérations ----------
 */

/// Règlement de délibération d'une année académique (seuils, arrondi, mentions, décisions).
model ReglementAcademique {
  id       String          @id @default(cuid())
  anneeId  String          @unique
  annee    AnneeAcademique @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  regles   Json
  majLe    DateTime        @updatedAt
  majParId String?
}

enum PeriodeDeliberation {
  SEMESTRE
  ANNUELLE
}

enum StatutDeliberation {
  PREPARATION
  CLOTUREE
  PROCLAMEE
}

/// Session du jury pour une promotion : un semestre, ou l'année entière (semestre = 0).
model Deliberation {
  id             String                 @id @default(cuid())
  promotionId    String
  promotion      Promotion              @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  periode        PeriodeDeliberation
  semestre       Int                    @default(0)
  statut         StatutDeliberation     @default(PREPARATION)
  /// Règlement appliqué, figé à la clôture du jury.
  regles         Json?
  dateJury       DateTime?
  secretaireJury String?
  presidentJury  String?
  calculeLe      DateTime?
  clotureLe      DateTime?
  clotureParId   String?
  proclameLe     DateTime?
  proclameParId  String?
  creeLe         DateTime               @default(now())
  resultats      ResultatDeliberation[]

  @@unique([promotionId, periode, semestre])
}

model ResultatDeliberation {
  id                String            @id @default(cuid())
  deliberationId    String
  deliberation      Deliberation      @relation(fields: [deliberationId], references: [id], onDelete: Cascade)
  etudiantId        String
  etudiant          ProfilEtudiant    @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  moyenne           Decimal?          @db.Decimal(5, 2)
  moyenneBrute      Decimal?          @db.Decimal(7, 3)
  total             Decimal           @db.Decimal(8, 2)
  creditsValides    Int
  creditsTotal      Int
  coursNonPresentes Int               @default(0)
  mention           String?
  mentionLibelle    String?
  rang              Int?
  decisionProposee  String?
  decisionJury      String?
  motifJury         String?
  casLimite         String?
  /// Détail figé par cours : intitulé, UE, semestre, crédits, note, validé.
  details           Json
  documentId        String?           @unique
  document          DocumentOfficiel? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([deliberationId, etudiantId])
}

/**
 * ---------- Examens ----------
 */

enum TypeSessionExamen {
  ORDINAIRE
  RATTRAPAGE
}

enum StatutSessionExamen {
  BROUILLON
  PUBLIEE
}

enum ModaliteEpreuve {
  ECRIT
  ORAL
  PRATIQUE
}

/// Session d'examens (ordinaire ou de rattrapage) d'une année académique.
model SessionExamen {
  id        String              @id @default(cuid())
  anneeId   String
  annee     AnneeAcademique     @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  libelle   String
  type      TypeSessionExamen   @default(ORDINAIRE)
  /// Premier et dernier jour de la session (minuit, heure de Bukavu).
  debut     DateTime
  fin       DateTime
  statut    StatutSessionExamen @default(BROUILLON)
  consignes String?
  publieeLe DateTime?
  creeLe    DateTime            @default(now())
  epreuves  Epreuve[]

  @@index([anneeId])
}

/// Épreuve d'un cours pendant une session : date, heures, salle, surveillants.
model Epreuve {
  id            String               @id @default(cuid())
  sessionId     String
  session       SessionExamen        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coursOffertId String
  coursOffert   CoursOffert          @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  debut         DateTime
  fin           DateTime
  salle         String?
  modalite      ModaliteEpreuve      @default(ECRIT)
  remarque      String?
  majLe         DateTime             @updatedAt
  surveillants  EpreuveSurveillant[]

  @@index([sessionId])
  @@index([coursOffertId])
}

model EpreuveSurveillant {
  epreuveId    String
  epreuve      Epreuve          @relation(fields: [epreuveId], references: [id], onDelete: Cascade)
  enseignantId String
  enseignant   ProfilEnseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@id([epreuveId, enseignantId])
}

/**
 * ---------- Anciens et insertion ----------
 */

enum StatutAncien {
  EN_ATTENTE
  PUBLIE
  REFUSE
  RETIRE
}

/// Inscription volontaire d'un diplômé à l'annuaire public des anciens,
/// publiée après vérification par l'institut et retirable à tout moment.
model Ancien {
  id                String       @id @default(cuid())
  nom               String
  postnom           String?
  prenom            String
  email             String
  filiereId         String?
  filiere           Filiere?     @relation(fields: [filiereId], references: [id], onDelete: SetNull)
  anneeSortie       Int
  poste             String?
  employeur         String?
  ville             String?
  parcours          String?
  lienProfessionnel String?
  statut            StatutAncien @default(EN_ATTENTE)
  motifRefus        String?
  consentementLe    DateTime
  /// Empreinte du lien personnel de retrait envoyé par email.
  jetonRetraitHash  String?      @unique
  verifieParId      String?
  verifieLe         DateTime?
  creeLe            DateTime     @default(now())
  majLe             DateTime     @updatedAt

  @@index([statut, anneeSortie])
}

enum TypeOffre {
  STAGE
  EMPLOI
  BOURSE
  FORMATION
}

enum StatutOffre {
  BROUILLON
  PUBLIEE
  ARCHIVEE
}

/// Offre de stage, d'emploi, de bourse ou de formation publiée par l'institut.
model OffreInsertion {
  id               String      @id @default(cuid())
  titre            String
  type             TypeOffre
  organisation     String
  lieu             String?
  description      String
  lienCandidature  String?
  emailCandidature String?
  dateLimite       DateTime?
  statut           StatutOffre @default(BROUILLON)
  publieeLe        DateTime?
  auteurId         String?
  filieres         Filiere[]
  creeLe           DateTime    @default(now())
  majLe            DateTime    @updatedAt

  @@index([statut, publieeLe])
}

/**
 * ---------- Messagerie (lot A de la communauté) ----------
 */

enum TypeConversation {
  PRIVEE
  PROMOTION
  COURS
}

/// Conversation privée (deux personnes) ou groupe automatique (promotion, cours).
/// L'appartenance aux groupes est recalculée à partir des inscriptions et des
/// affectations : la ligne ParticipantConversation ne sert qu'au suivi de lecture.
model Conversation {
  id                String                    @id @default(cuid())
  type              TypeConversation
  /// « privee:<a>:<b> », « promotion:<id> » ou « cours:<id> » : une seule conversation par paire ou par groupe.
  cle               String                    @unique
  titre             String?
  promotionId       String?
  promotion         Promotion?                @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  coursOffertId     String?
  coursOffert       CoursOffert?              @relation(fields: [coursOffertId], references: [id], onDelete: Cascade)
  /// Groupe de cours : seuls les enseignants écrivent.
  annoncesSeulement Boolean                   @default(false)
  dernierMessageLe  DateTime?
  creeLe            DateTime                  @default(now())
  participants      ParticipantConversation[]
  messages          Message[]

  @@index([dernierMessageLe])
}

model ParticipantConversation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  animateur      Boolean      @default(false)
  /// Messages lus jusqu'à cet instant.
  luJusquA       DateTime?
  sourdine       Boolean      @default(false)
  /// Sorti du groupe (changement de promotion, fin d'affectation).
  quitteLe       DateTime?
  creeLe         DateTime     @default(now())

  @@unique([conversationId, utilisateurId])
  @@index([utilisateurId])
}

model Message {
  id             String               @id @default(cuid())
  conversationId String
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteurId       String?
  auteur         Utilisateur?         @relation("MessagesAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  contenu        String
  reponseAId     String?
  reponseA       Message?             @relation("Reponses", fields: [reponseAId], references: [id], onDelete: SetNull)
  reponses       Message[]            @relation("Reponses")
  mediaId        String?
  media          Media?               @relation("PieceMessage", fields: [mediaId], references: [id], onDelete: SetNull)
  creeLe         DateTime             @default(now())
  supprimeLe     DateTime?
  /// Masqué par la modération après un signalement.
  masqueLe       DateTime?
  signalements   SignalementMessage[]

  @@index([conversationId, creeLe])
  @@index([auteurId, creeLe])
}

model SignalementMessage {
  id          String      @id @default(cuid())
  messageId   String
  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  auteurId    String
  auteur      Utilisateur @relation("SignalementsAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  motif       String
  /// Copie du contenu au moment du signalement (preuve conservée si l'auteur le supprime).
  extrait     String?
  creeLe      DateTime    @default(now())
  traiteLe    DateTime?
  traiteParId String?
  /// MASQUE (message retiré) ou CLASSE (rien à reprocher).
  decision    String?

  @@unique([messageId, auteurId])
  @@index([traiteLe])
}

/// Une personne qui ne veut plus recevoir de messages privés d'une autre.
model Blocage {
  bloqueurId String
  bloqueur   Utilisateur @relation("BlocagesFaits", fields: [bloqueurId], references: [id], onDelete: Cascade)
  bloqueId   String
  bloque     Utilisateur @relation("BlocagesSubis", fields: [bloqueId], references: [id], onDelete: Cascade)
  creeLe     DateTime    @default(now())

  @@id([bloqueurId, bloqueId])
}

/**
 * ---------- Campus (lot B de la communauté) ----------
 */

enum AudienceCampus {
  INSTITUT
  FILIERE
  PROMOTION
}

enum StatutPublicationCampus {
  PUBLIEE
  /// Validation préalable activée : en attente de la modération.
  EN_ATTENTE
  REFUSEE
}

model Publication {
  id                 String                      @id @default(cuid())
  auteurId           String?
  auteur             Utilisateur?                @relation("PublicationsAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  contenu            String
  audience           AudienceCampus              @default(INSTITUT)
  filiereId          String?
  filiere            Filiere?                    @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  promotionId        String?
  promotion          Promotion?                  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  statut             StatutPublicationCampus     @default(PUBLIEE)
  epingleLe          DateTime?
  commentairesFermes Boolean                     @default(false)
  creeLe             DateTime                    @default(now())
  modifieLe          DateTime?
  supprimeLe         DateTime?
  /// Masquée par la modération, ou automatiquement après plusieurs signalements.
  masqueLe           DateTime?
  /// Personnes mentionnées (« @Prénom Nom »), prévenues à la publication.
  mentions           String[]                    @default([])
  medias             PublicationMedia[]
  reactions          ReactionPublication[]
  commentaires       Commentaire[]
  enregistrements    EnregistrementPublication[]
  signalements       SignalementCampus[]

  @@index([creeLe])
  @@index([statut, creeLe])
}

model PublicationMedia {
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  ordre         Int         @default(0)

  @@id([publicationId, mediaId])
  @@index([mediaId])
}

/// « J'aime » : une réaction par personne et par publication.
model ReactionPublication {
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())

  @@id([publicationId, utilisateurId])
}

model Commentaire {
  id            String              @id @default(cuid())
  publicationId String
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  auteurId      String?
  auteur        Utilisateur?        @relation("CommentairesAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  /// Réponse à un commentaire (un seul niveau).
  parentId      String?
  parent        Commentaire?        @relation("ReponsesCommentaire", fields: [parentId], references: [id], onDelete: SetNull)
  reponses      Commentaire[]       @relation("ReponsesCommentaire")
  contenu       String
  creeLe        DateTime            @default(now())
  modifieLe     DateTime?
  supprimeLe    DateTime?
  masqueLe      DateTime?
  mentions      String[]            @default([])
  signalements  SignalementCampus[]

  @@index([publicationId, creeLe])
}

/// Publications mises de côté par un utilisateur (« Enregistrés »).
model EnregistrementPublication {
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())

  @@id([publicationId, utilisateurId])
}

/// Signalement d'une publication ou d'un commentaire.
model SignalementCampus {
  id            String       @id @default(cuid())
  /// « publication:<id> » ou « commentaire:<id> » : un signalement par personne et par contenu.
  cible         String
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  commentaireId String?
  commentaire   Commentaire? @relation(fields: [commentaireId], references: [id], onDelete: Cascade)
  auteurId      String
  auteur        Utilisateur  @relation("SignalementsCampusAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  motif         String
  /// Copie du contenu au moment du signalement (preuve conservée si l'auteur le supprime).
  extrait       String?
  creeLe        DateTime     @default(now())
  traiteLe      DateTime?
  traiteParId   String?
  decision      String?

  @@unique([cible, auteurId])
  @@index([traiteLe])
}

/// Abonnement aux notifications sur le téléphone (Web Push), un par appareil.
model AbonnementPush {
  id             String      @id @default(cuid())
  utilisateurId  String
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  /// Adresse fournie par le service de notification du navigateur (unique par appareil).
  endpoint       String      @unique
  p256dh         String
  auth           String
  agent          String?
  /// Session qui a activé l'abonnement : sa fermeture (déconnexion, changement de
  /// mot de passe, suspension, expiration) supprime l'abonnement.
  sessionId      String?
  session        Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  creeLe         DateTime    @default(now())
  dernierEnvoiLe DateTime?

  @@index([utilisateurId])
  @@index([sessionId])
}
