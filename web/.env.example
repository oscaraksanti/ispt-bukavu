# Base de données PostgreSQL
# Production (Supabase) : connexion mutualisée (port 6543) pour l'application,
# connexion directe (port 5432) pour les migrations.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://utilisateur:motdepasse@hote:5432/postgres"

# Adresse publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stockage des fichiers (Supabase Storage). Sans ces variables, les fichiers
# sont enregistrés sur le disque local (développement uniquement).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STOCKAGE_BUCKET="medias"

# Emails transactionnels (Resend). Sans clé, les emails sont affichés dans la console.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="ISPT-Bukavu <notifications@exemple.cd>"
EMAIL_REPONSE="ispt.bk@gmail.com"

# Compte administrateur technique créé au premier déploiement (seed)
ADMIN_EMAIL=""
ADMIN_MOT_DE_PASSE=""

# Instance de démonstration uniquement (jamais en production) : bandeau,
# comptes de démonstration affichés, aucun email envoyé, données fictives.
NEXT_PUBLIC_MODE_DEMO=""

# Tâche planifiée de purge (vercel.json → /api/taches/purge). Vercel envoie ce
# secret à chaque déclenchement ; sans lui, la route refuse de s'exécuter.
# Valeur aléatoire d'au moins 32 caractères (par exemple : openssl rand -hex 32).
CRON_SECRET=""
